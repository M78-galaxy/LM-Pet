{
  "name": "lm-pet",
  "version": "0.1.2",
  "private": true,
  "description": "LM-Pet",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "dist": "node scripts/pack-mac.cjs",
    "dist:win": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "app.lm-pet.desktop",
    "productName": "LM-Pet",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "index.html",
      "settings.html",
      "package.json",
      "assets/logo.png",
      "assets/lumu-thumb.png",
      "assets/A-sit-talk.png",
      "assets/B-sit-talk.png",
      "assets/An_pet/idle-2025sport.webp",
      "assets/An_pet/idle-handhold.webp",
      "assets/An_pet/idle-zhenai.webp",
      "catalog.json",
      "settings.json"
    ],
    "extraResources": [
      {
        "from": "bin/lm-pet-dragwatch",
        "to": "bin/lm-pet-dragwatch"
      }
    ],
    "mac": {
      "category": "public.app-category.entertainment",
      "target": [
        "dmg"
      ],
      "icon": "assets/logo.png",
      "identity": null,
      "gatekeeperAssess": false,
      "x64ArchFiles": "Contents/Resources/bin/lm-pet-dragwatch"
    },
    "dmg": {
      "title": "LM-Pet"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/logo.png"
    }
  }
}
